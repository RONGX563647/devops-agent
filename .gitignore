# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# runtime workspace (NOT committed — process state lives here, not source)
/workspace/

# secrets & env
.env
.env.*
!.env.example
*.key
*.pem
# 只忽略项目根下的运行期密钥目录：源码包 src/devops_agent/secrets 必须入库
/secrets/

# 「以后都这样」的沉淀规则与信任目录：写的是本机绝对路径，只在部署机生成
config/permissions.local.yaml

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
# 不同 mutmut 版本对它要么落成文件、要么落成目录；尾斜杠只匹配目录，
# 用通配同时盖住两种形态，避免换版本后缓存被误提交
.mutmut-cache*

# mutmut 3.x 的变异源码落盘目录（3.8 实测：不再用 .mutmut-cache，改为 mutants/）
mutants/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# 本地工作目录（截图/临时探针/会话记忆，377MB，不入库）
/.workbuddy/
