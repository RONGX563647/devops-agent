[importlinter]
root_package = devops_agent
include_external_packages = True

[importlinter:contract:prompt-lint-no-framework]
name = prompt_lint 层不得直接依赖 AgentScope
type = forbidden
source_modules = devops_agent.prompt_lint
forbidden_modules = agentscope
allow_indirect_imports = True

# 权限的「数据层」必须零框架：它被 prompt_lint / eval 那类不得依赖框架的层直接
# import。旧实现里 profiles.py 通过 tools.catalog 间接拉进 agentscope，靠
# allow_indirect_imports=True 放行 —— 契约看起来成立，实际不成立。
[importlinter:contract:governance-data-no-framework]
name = governance 的数据层（model / presets）不得依赖 AgentScope（直接或间接）
type = forbidden
source_modules =
    devops_agent.governance.model
    devops_agent.governance.presets
forbidden_modules = agentscope

[importlinter:contract:input-no-framework]
name = input 层不得直接依赖 AgentScope
type = forbidden
source_modules = devops_agent.input
forbidden_modules = agentscope
allow_indirect_imports = True

[importlinter:contract:observability-no-framework]
name = observability 层不得直接依赖 AgentScope
type = forbidden
source_modules = devops_agent.observability
forbidden_modules = agentscope
allow_indirect_imports = True

[importlinter:contract:observability-no-gateway]
name = observability 不得反向依赖网关
type = forbidden
source_modules = devops_agent.observability
forbidden_modules = devops_agent.gateway

[importlinter:contract:input-no-runtime]
name = input 不得依赖 runtime
type = forbidden
source_modules = devops_agent.input
forbidden_modules = devops_agent.runtime

[importlinter:contract:runtime-no-gateway]
name = runtime 不得反向依赖网关
type = forbidden
source_modules = devops_agent.runtime
forbidden_modules = devops_agent.gateway

[importlinter:contract:gateway-no-framework]
name = gateway 不得直接依赖 AgentScope
type = forbidden
source_modules = devops_agent.gateway
forbidden_modules = agentscope
allow_indirect_imports = True

# 网关内部的分层：contract（帧与载荷）与 errors（错误码）是叶子。
# 它们是前后端契约，改的人只该关心「字段/状态码是否齐」，
# 不该被会话锁、编排顺序、持久化细节牵连；反过来，把契约塞进路由模块
# 会让「改一个帧字段」变成「改五个文件」。
[importlinter:contract:gateway-contract-is-leaf]
name = 网关契约与错误码必须是叶子（不得依赖其他网关模块）
type = forbidden
source_modules =
    devops_agent.gateway.contract
    devops_agent.gateway.errors
forbidden_modules =
    devops_agent.gateway.app
    devops_agent.gateway.bootstrap
    devops_agent.gateway.confirm
    devops_agent.gateway.deps
    devops_agent.gateway.ending
    devops_agent.gateway.health
    devops_agent.gateway.input_prep
    devops_agent.gateway.lease
    devops_agent.gateway.ports
    devops_agent.gateway.run
    devops_agent.gateway.sessions
    devops_agent.gateway.settings
    devops_agent.gateway.sse
    devops_agent.gateway.stream
