{
  "$schema": "https://opencode.ai/config.json",
  "model": "dashscope/qwen3.8-flash",
  "default_agent": "reviewer",
  "agents": {
    "reviewer": {
      "mode": "primary",
      "steps": 1,
      "system": "审查 prompt 中提供的代码改动。列出所有确认的问题，每条标注 file:line，按严重度从高到低排序。跳过风格/命名/文档建议，不报推测性问题。末尾单独一行输出 FINDINGS_TOTAL: <问题总数>。不要输出其它内容。"
    }
  },
  "providers": {
    "dashscope": {
      "name": "DashScope Compatible",
      "env": ["OPENCODE_REVIEW_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://llm-ah65cbyzn2a9z0d2.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
      },
      "models": {
        "qwen3.8-flash": {
          "name": "qwen3.8-flash",
          "modelID": "qwen3.8-flash",
          "limit": { "output": 16000 }
        }
      }
    }
  }
}
